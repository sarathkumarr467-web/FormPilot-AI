# ====================================================================
# FORMPILOT AI — ENVIRONMENT CONFIGURATION
# ====================================================================

# Application Settings
PROJECT_NAME="FormPilot AI"
TAGLINE="Understand. Fill. Verify. Apply."
ENVIRONMENT="development"
PORT=8000
SECRET_KEY="replace-with-your-strong-random-secret-key-in-production"

# Database Configuration (Defaults to zero-config local SQLite if empty)
# For Supabase PostgreSQL, use:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=""

# Supabase Auth & Storage Configuration
SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Google OAuth (Configured via Supabase Auth Dashboard)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Optional Cloud LLM API Keys (FormPilot includes high-accuracy local NLP fallback)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Storage Constraints
MAX_FILE_SIZE_MB=50
